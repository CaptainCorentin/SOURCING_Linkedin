{
  "manifest_version": 3,
  "name": "Sourcing LinkedIn (Prototype)",
  "version": "0.1.0",
  "description": "Prototype de sourcing LinkedIn avec données Boond fictives (sans API).",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"]
}
